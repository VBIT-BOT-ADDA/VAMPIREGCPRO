{
  "name": "NSFW-PROTECTION-BOT",
  "description": "Advanced AI Telegram Group Moderation Bot with NSFW, Bio Link and Bad Word Protection",
  "repository": "IMPORT YOUR SOURCE LINK",
  "keywords": [
    "telegram",
    "bot",
    "pyrogram",
    "moderation",
    "nsfw",
    "mongodb",
    "sightengine",
    "protection"
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API Hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Bot Token from @BotFather",
      "required": true
    },
    "MONGO_DB_URI": {
      "description": "Your MongoDB Atlas Connection URL",
      "required": true
    },
    "SIGHTENGINE_API_USER": {
      "description": "Sightengine API User Key",
      "required": true
    },
    "SIGHTENGINE_API_SECRET": {
      "description": "Sightengine API Secret Key",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram User ID of the Bot Owner",
      "required": true
    },
    "OWNER_USERNAME": {
      "description": "Telegram username of the owner, with or without @",
      "required": true
    },
    "LOGGER_ID": {
      "description": "Telegram Channel ID for bot logs",
      "required": true
    },
    "SUPPORT_GROUP": {
      "description": "Support Group Telegram Link",
      "required": false,
      "value": "https://t.me/YourSupportGroup"
    },
    "UPDATE_CHANNEL": {
      "description": "Update Channel Telegram Link",
      "required": false,
      "value": "https://t.me/YourUpdateChannel"
    },
    "WELCOME_IMAGE": {
      "description": "Direct image URL for the bot welcome/start message",
      "required": false,
      "value": "https://graph.org/file/f681a97d813735f492a83.jpg"
    },
    "START_IMG": {
      "description": "Fallback start/welcome image URL",
      "required": false,
      "value": "https://graph.org/file/f681a97d813735f492a83.jpg"
    },
    "BIO_LINK_PROTECTION": {
      "description": "Enable Telegram link detection in user bios",
      "required": false,
      "value": "True"
    },
    "BAD_WORD_PROTECTION": {
      "description": "Enable abusive/bad word detection",
      "required": false,
      "value": "True"
    },
    "MAX_WARNINGS": {
      "description": "Number of warnings before automatic mute",
      "required": false,
      "value": "3"
    },
    "WARNING_BUTTONS": {
      "description": "Show Update and Support buttons below warnings",
      "required": false,
      "value": "True"
    },
    "BOT_NAME": {
      "description": "Bot display name",
      "required": false,
      "value": "NSFW PROTECTION BOT"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
